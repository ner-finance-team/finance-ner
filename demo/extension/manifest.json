{
  "manifest_version": 3,
  "name": "뉴스 개체명 인식 (NER 데모)",
  "version": "0.1.0",
  "description": "네이버 뉴스 기사 제목·본문의 개체를 태그 색으로 표시하고 리포트를 보여 줍니다. 로컬 NER 서버(기본 http://localhost:8000)를 씁니다.",
  "permissions": ["storage"],
  "host_permissions": ["http://localhost:8000/*", "http://127.0.0.1:8000/*", "http://*/*", "https://*/*"],
  "background": { "service_worker": "background.js" },
  "action": { "default_title": "NER 패널 열기/닫기" },
  "content_scripts": [{
    "matches": ["https://n.news.naver.com/*article/*", "https://n.news.naver.com/article/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_idle"
  }]
}
